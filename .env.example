# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# 32 random bytes, base64. Generate with: npm run keygen
#
# This is one of TWO factors protecting the journal. The database alone cannot
# be decrypted without it, and it alone cannot decrypt anything without your
# password. Back it up SEPARATELY from your database backups -- storing both in
# the same place defeats the entire scheme.
#
# Losing it is unrecoverable. Changing it invalidates every password hash and
# every wrapped data key.
MASTER_KEY=

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://drem:drem@localhost:5432/drem
POSTGRES_PASSWORD=drem

# Host port published by Docker Compose. The container still listens on 3000.
DREM_PORT=43817

# Used for strict Origin checks on every state-changing request. Set this to the
# exact URL you use to reach drem, including any non-default port. Set it to the
# real external URL once you put the app behind a reverse proxy with TLS.
APP_ORIGIN=http://localhost:43817

# NODE_ENV is deliberately NOT set here. Next sets it itself
# (development for `next dev`, production for `next build`/`start`),
# and overriding it mixes React's dev and prod bundles.


# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# Ollama runs on the host, not in a container, so it keeps GPU access.
# From inside Docker this must be host.docker.internal; from `npm run dev` on
# the host it is 127.0.0.1.
OLLAMA_BASE_URL=http://127.0.0.1:11434
WHISPER_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Trade-offs -- read before changing
# ---------------------------------------------------------------------------

# false: queued AI jobs run only while you are logged in, because the data key
#        exists solely in the memory of a live session.
# true:  a second copy of the data key is stored wrapped under MASTER_KEY so
#        jobs can run headless. This WEAKENS the model -- MASTER_KEY plus the
#        database then suffices to decrypt your journal.
ALLOW_BACKGROUND_PROCESSING=false

# encrypted: embedding vectors are encrypted at rest and similarity runs in
#            memory. Correct for a personal journal (a few MB of vectors).
# pgvector:  vectors stored in a queryable ANN index -- faster past ~20k
#            entries, but vectors are invertible enough to leak content.
SEARCH_BACKEND=encrypted

# ---------------------------------------------------------------------------
# Storage and sessions
# ---------------------------------------------------------------------------

UPLOAD_DIR=./data/uploads

SESSION_IDLE_TIMEOUT=28800
SESSION_ABSOLUTE_TIMEOUT=604800
