# ---------------------------------------------------------------------------
# Development configuration — committed on purpose, and public.
# ---------------------------------------------------------------------------
#
# Every value in this file is worthless to an attacker, which is the point: a
# fresh checkout runs with no setup step, and nothing here is ever confused for
# a secret. It configures a journal full of generated dreams, in a Postgres
# cluster of its own, encrypted under a key printed below.
#
# `next dev` reads this file over `.env` without being asked; the scripts read
# it because they were told to (see `scripts/env-file.ts`).
#
# Personal overrides — a different port, a real model endpoint — go in
# `.env.development.local`, which is ignored by git and read first.
#
# The real journal is configured by `.env`, which this file must never name.
# See CONTRIBUTING.md.

# Declares which of the three journals this process may touch. The database
# name has to agree with it or nothing starts. See src/lib/db-environment.ts.
DREM_ENV=development

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# The dev cluster, published on loopback by `npm run dev:up`. It is a different
# container and a different volume from the production one, which lives on 5433.
DATABASE_URL=postgresql://drem:drem@localhost:5432/drem_dev
POSTGRES_PASSWORD=drem

# A different port from production's 43817, so both can run at once. The port
# itself is in the `dev` script in package.json; these two have to agree,
# because APP_ORIGIN is compared literally by the CSRF check and localhost and
# 127.0.0.1 are not interchangeable.
APP_ORIGIN=http://localhost:43818

# 32 bytes of base64 that decode to the ASCII "drem dev key - not a secret ----".
# Shared by every checkout so a dev journal is reproducible. The app refuses to
# start in production with this key set: see masterKeyMismatch().
MASTER_KEY=ZHJlbSBkZXYga2V5IC0gbm90IGEgc2VjcmV0IC0tLS0=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# Ollama runs on the host and is shared with production: it holds no journal
# data, only models. Whisper is the dev project's own container.
OLLAMA_BASE_URL=http://127.0.0.1:11434
WHISPER_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Trade-offs
# ---------------------------------------------------------------------------

# Both left at the production defaults on purpose. A development environment
# that quietly runs with weaker settings is one that cannot reproduce a bug
# report — flip them here when you are working on what they gate, not by habit.
ALLOW_BACKGROUND_PROCESSING=false
SEARCH_BACKEND=encrypted

# ---------------------------------------------------------------------------
# Storage and sessions
# ---------------------------------------------------------------------------

# Separate from production's ./data/uploads, and emptied by `npm run dev:reset`.
UPLOAD_DIR=./data/dev-uploads

SESSION_IDLE_TIMEOUT=28800
SESSION_ABSOLUTE_TIMEOUT=604800

# ---------------------------------------------------------------------------
# The seeded account
# ---------------------------------------------------------------------------
#
# Created by `npm run dev:reset`. No TOTP, so login is one step. Real by the
# app's standards — 12 characters is the enforced minimum — and public by ours.
DREM_DEV_EMAIL=dev@drem.local
DREM_DEV_PASSWORD=development-journal

# The development cluster's container, used by the pg_dump canary in
# accounts.integration.test.ts. Named after the compose project (drem-dev).
DREM_DEV_DB_CONTAINER=drem-dev-db-1
