{
  "name": "drem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 43818",
    "build": "next build && npm run build:assets",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:compose": "docker compose -p drem-dev --env-file .env.development -f docker-compose.yml -f docker-compose.dev.yml",
    "dev:up": "npm run dev:compose -- up -d db whisper",
    "dev:down": "npm run dev:compose -- down",
    "dev:destroy": "npm run dev:compose -- down -v",
    "dev:logs": "npm run dev:compose -- logs -f",
    "dev:reset": "tsx scripts/dev-reset.ts",
    "dev:account": "tsx --conditions=react-server scripts/dev-account.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:generate": "tsx scripts/drizzle.ts generate --env development",
    "db:migrate": "tsx scripts/drizzle.ts migrate --env development",
    "db:migrate:prod": "tsx scripts/drizzle.ts migrate --env production",
    "db:push": "tsx scripts/drizzle.ts push --env development",
    "db:studio": "tsx scripts/drizzle.ts studio --env development",
    "db:studio:prod": "tsx scripts/drizzle.ts studio --env production",
    "keygen": "tsx scripts/generate-keys.ts",
    "build:assets": "mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
